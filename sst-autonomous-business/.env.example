# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.
# Sem credenciais, o sistema funciona em modo interno (pesquisa por CSV, qualificação, rascunhos,
# relatórios) e registra cada integração faltante em "integrações pendentes".

# ---------------------------------------------------------------- segurança operacional
# Envio externo desligado por padrão. Ligue só depois de: configurar identidade em config/business.json,
# rodar `python -m src.main integrations` com sucesso e revisar config/outreach.json e config/autonomy.json.
EXTERNAL_SENDING_ENABLED=false
# KILL_SWITCH=true suspende imediatamente qualquer envio externo (equivale a `kill-switch on`).
KILL_SWITCH=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------- e-mail profissional (SMTP)
# Use o provedor do seu domínio (ex.: Google Workspace, Microsoft 365, Zoho). Prefira "senha de app".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ---------------------------------------------------------------- leitura de respostas (IMAP)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------- pesquisa
# Brave Search API (https://api.search.brave.com) — chave própria, termos aceitos pelo titular da conta.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COST_BRL=0
# E-mail exibido no User-Agent do robô de leitura de sites (transparência).
RESEARCH_CONTACT_EMAIL=
# Consulta de porte/CNAE pelo CNPJ (dados públicos da Receita via BrasilAPI). Sem chave.
CNPJ_LOOKUP_ENABLED=false

# ---------------------------------------------------------------- opcionais
# Provedor B2B licenciado (somente com termos que permitam prospecção)
B2B_PROVIDER=
B2B_API_KEY=
# CRM externo (o CRM principal é o SQLite local)
EXTERNAL_CRM=
EXTERNAL_CRM_TOKEN=
# Agenda externa (os convites .ics locais já funcionam sem isso)
CALENDAR_PROVIDER=
CALENDAR_CREDENTIALS_FILE=
# Modelo de IA (opcional; sugere respostas, que continuam passando por filtro e aprovação)
ANTHROPIC_API_KEY=
AI_MODEL=
AI_COST_PER_CALL_BRL=0

# ---------------------------------------------------------------- caminhos (opcional)
# SST_DB_PATH=data/sst.db
# SST_DATA_DIR=data
# SST_REPORTS_DIR=reports
